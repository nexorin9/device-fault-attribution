# 医疗设备故障归因系统 —— 环境变量清单
#
# 原则：凭据一律从环境变量读取，代码里不硬编码、不写日志、不入库。
# 本文件只列键位与用途，真实值请写入本机 `.env`（已被 .gitignore 排除）
# 或由运维在系统环境变量中注入。
#
# 复制使用：cp .env.example .env

# ── 工单系统（本轮主路径的出站写 + 故障工单入站读 + 班组能力读）──
# 工单系统基地址，例如 https://his.example-hospital.local
WORKORDER_BASE_URL=
# 工单系统访问令牌（Bearer），由院内工单系统管理员签发
WORKORDER_TOKEN=

# ── 设备台账（设备身份真源，入站只读）───────────────────────────
# 后勤/设备台账基地址，例如 https://logistics.example-hospital.local
LOGISTICS_DEVICE_BASE_URL=
# 设备台账访问令牌（Bearer）
LOGISTICS_DEVICE_TOKEN=

# ── 模型网关（单一 OpenAI-compatible 协议，base_url 可指向院内部署）──
# 兼容 OpenAI Chat Completions 的模型服务基地址，例如 http://10.0.0.9:8000/v1
MODEL_BASE_URL=
# 模型服务访问令牌；院内自建端点若不校验可留空
MODEL_API_KEY=
# 模型名，例如 qwen2.5-instruct / gpt-4o-mini
MODEL_MODEL=
# 单次调用超时（秒）；默认 30
MODEL_TIMEOUT_SECS=30
